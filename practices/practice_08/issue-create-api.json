      "name": "Создать Issue в GitHub",
      "credentials": {
        "githubApi": { "id": "LwL1mHIsq5IXKuVo", "name": "GitHub account 11" }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nif (response.valid === false) {\n  return [{ json: { status: response.status, payload: response.payload } }];\n}\n\nconst { statusCode, body } = response;\nif (statusCode === 201) {\n  return [{ json: { status: 201, payload: { number: body.number, url: body.html_url } } }];\n}\n\nconst rejected = statusCode >= 400 && statusCode < 500;\nreturn [{ json: {\n  status: rejected ? statusCode : 502,\n  payload: { code: rejected ? 'github_rejected' : 'github_unavailable' },\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0],
      "id": "25ceb480-0e49-4f05-9133-a535f7765a6d",
