    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body;\nconst title = typeof payload?.title === 'string' ? payload.title.trim() : '';\nconst body = payload?.body ?? '';\nconst valid = title.length > 0 && title.length <= 120\n  && typeof body === 'string' && body.trim().length <= 2000;\n\nreturn [{ json: valid\n  ? { valid, title, body: body.trim() }\n  : { valid, status: 400, payload: { code: 'invalid_draft' } }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "id": "272ddfca-be0e-4ceb-8978-e318dad6ad0c",
      "name": "Проверить черновик"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "0a34db8b-8f3f-4c14-856a-4bebc666f068",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
