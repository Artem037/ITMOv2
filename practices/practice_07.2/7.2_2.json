    {
      "parameters": {
        "jsCode": "const { issue, repository } = $('Github Trigger').first().json.body;\nconst { type, confidence } = $input.first().json;\nconst accepted = ['bug', 'task', 'feature'].includes(type)\n  && Number.isFinite(confidence) && confidence >= 0.8 && confidence <= 1;\nconst route = accepted ? type : 'unknown';\nconst newContributor = accepted && issue.author_association === 'NONE';\nconst replies = {\n  bug: 'Спасибо за сообщение о баге! При необходимости добавьте шаги воспроизведения, ожидаемый и фактический результат.',\n  task: 'Спасибо за вопрос! Мейнтейнер посмотрит обращение и ответит в этом Issue.',\n  feature: 'Спасибо за идею! Если нужно, дополните её примером того, как должна работать новая функция.',\n};\nconst readme = 'https://github.com/' + repository.full_name + '/blob/' + (repository.default_branch ?? 'main') + '/README.md';\nconst welcome = newContributor ? 'Рады вашему обращению! О проекте можно прочитать в [README](' + readme + ').\\n\\n' : '';\nreturn [{ json: {\n  type, confidence, route, newContributor,\n  issueId: String(issue.id), number: issue.number,\n  author: issue.user.login, createdAt: issue.created_at,\n  issueApi: 'https://api.github.com/repos/' + repository.full_name + '/issues/' + issue.number,\n  message: accepted ? welcome + replies[route] : '',\n} }];"
      },
