        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"bug\",\n        \"task\",\n        \"feature\",\n        \"unknown\"\n      ]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    }\n  },\n  \"required\": [\n    \"type\",\n    \"confidence\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        80,
        80
      ],
      "id": "ed0fc624-951c-468f-8a9a-7a07ff559a79",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json }, index) => {\n  const result = json.output ?? json;\n  const type = result.type;\n  const confidence = result.confidence;\n  const valid = ['bug', 'task', 'feature', 'unknown'].includes(type)\n    && Number.isFinite(confidence) && confidence >= 0 && confidence <= 1;\n  return {\n    json: valid ? { type, confidence } : { type: 'unknown', confidence: 0 },\n    pairedItem: { item: index },\n  };\n});"
      },
