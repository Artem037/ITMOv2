{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "mcp": {
    "fetch": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/uvx",
        "mcp-server-fetch@2026.8.18"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "trip_planner": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "practices/practice_04/homework",
        "--locked",
        "--offline",
        "python",
        "-m",
        "trip_planner.server"
      ],
      "enabled": true,
      "timeout": 15000
    }
  },
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4.6": {
          "name": "anthropic/claude-sonnet-4.6"
        }
      }
    }
  }
}
